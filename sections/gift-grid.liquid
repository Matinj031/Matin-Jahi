{{ 'gift-grid.css' | asset_url | stylesheet_tag }}

<section class="gift-grid">
  <div class="gift-grid__inner">
    <h2 class="gift-grid__title">
      {{ section.settings.heading }}
    </h2>

    <div class="gift-grid__grid">
      {% for block in section.blocks %}
        <div class="gift-grid__item">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 433, height: 444 }}"
              alt="{{ block.settings.image.alt | escape }}"
              class="gift-grid__item-image"
              loading="lazy"
              width="433"
              height="444"
            >
            <img
              src="{{ 'gift-heart-icon.svg' | asset_url }}"
              alt=""
              class="gift-grid__item-heart"
              style="left: {{ block.settings.heart_position_x }}px; top: {{ block.settings.heart_position_y }}px;"
            >
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Grid",
  "tag": "section",
  "class": "section-gift-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift Grid"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "number",
          "id": "heart_position_x",
          "label": "Heart X Position",
          "default": 256
        },
        {
          "type": "number",
          "id": "heart_position_y",
          "label": "Heart Y Position",
          "default": 238
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift Grid",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
