{{ 'banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'banner.js' | asset_url }}" defer></script>

<section class="gift-banner">

  {%- comment -%} ===== Top bar: logo + announcement + Choose Gift button ===== {%- endcomment -%}
  <div class="gift-banner__topbar">
    <div class="gift-banner__topbar-inner">
    <button
      type="button"
      class="gift-banner__mobile-menu"
      aria-expanded="false"
      aria-controls="gift-banner-mobile-panel-{{ section.id }}"
    >
      <span class="visually-hidden">Toggle gift details</span>
      <svg
        class="gift-banner__mobile-menu-icon gift-banner__mobile-menu-icon--open"
        width="18"
        height="16"
        viewBox="0 0 18 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M1 .5h15.71M1 8h15.71M1 15h15.71"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
      <svg
        class="gift-banner__mobile-menu-icon gift-banner__mobile-menu-icon--close"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M1 1L15 15M15 1L1 15"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
    </button>

    <a href="{{ routes.root_url }}" class="gift-banner__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="153"
          height="19"
          loading="eager"
        >
      {%- else -%}
        <span class="gift-banner__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if section.settings.announcement_text != blank -%}
      <p class="gift-banner__announcement">{{ section.settings.announcement_text }}</p>
    {%- endif -%}

    {%- if section.settings.announcement_button_text != blank -%}
      <a
        href="{{ section.settings.announcement_button_link | default: '#' }}"
        class="gift-banner__topbar-button"
      >
        <span>{{ section.settings.announcement_button_text }}</span>
        <svg
          width="18"
          height="12"
          viewBox="0 0 18 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M1 6H16M16 6L11 1M16 6L11 11"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    {%- endif -%}
    </div>

    <div
      id="gift-banner-mobile-panel-{{ section.id }}"
      class="gift-banner__mobile-panel"
      hidden
    >
      {%- if section.settings.announcement_text != blank -%}
        <p class="gift-banner__mobile-panel-text">{{ section.settings.announcement_text }}</p>
      {%- endif -%}

      {%- if section.settings.announcement_button_text != blank -%}
        <a
          href="{{ section.settings.announcement_button_link | default: '#' }}"
          class="gift-banner__mobile-panel-button"
        >
          <span>{{ section.settings.announcement_button_text }}</span>
          <svg
            width="18"
            height="12"
            viewBox="0 0 18 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M1 6H16M16 6L11 1M16 6L11 11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ===== Hero: illustration + heading + description + Shop Now ===== {%- endcomment -%}
  <div class="gift-banner__hero">
    {%- comment -%}
      Everything below is scoped to a 1440px-max-width box, matching the
      Figma frame exactly. Without this wrapper, the graphics layer (which
      uses absolute positioning) inherits the full browser viewport width
      on screens wider than 1440px, and the illustrations drift/overflow
      to the right instead of staying inside the design's bounds.
    {%- endcomment -%}
    <div class="gift-banner__hero-inner">

      <div class="gift-banner__graphics" aria-hidden="true">
        <img
          src="{{ 'gift-illustration.svg' | asset_url }}"
          alt=""
          class="gift-banner__illustration"
          loading="eager"
          width="1440"
          height="780"
        >
        <img
          src="{{ 'Frame.svg' | asset_url }}"
          alt=""
          class="gift-banner__illustration-mobile"
          loading="eager"
          width="1052"
          height="400"
        >
      </div>

      <div class="gift-banner__content">

        <h1 class="gift-banner__title">
          {{ section.settings.heading }}
        </h1>

        <div class="gift-banner__description rte">
          {{ section.settings.description }}
        </div>

        <a
          href="{{ section.settings.button_link }}"
          class="gift-banner__button"
        >
          <span>{{ section.settings.button_text }}</span>
          <svg
            class="gift-banner__button-icon"
            width="18"
            height="12"
            viewBox="0 0 18 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M1 6H16M16 6L11 1M16 6L11 11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

      </div>

    </div>
  </div>

  {%- comment -%} ===== Bottom strip ===== {%- endcomment -%}
  {%- if section.settings.bottom_strip_text != blank -%}
    <div class="gift-banner__strip">
      <p>{{ section.settings.bottom_strip_text }}</p>
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Banner",
  "tag": "section",
  "class": "section-gift-banner",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to shop name if empty"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "announcement_button_text",
      "label": "Announcement button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "announcement_button_link",
      "label": "Announcement button link"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p><p>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Bottom strip"
    },
    {
      "type": "text",
      "id": "bottom_strip_text",
      "label": "Bottom strip text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
