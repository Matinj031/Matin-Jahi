{{ 'banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'banner.js' | asset_url }}" defer></script>

<section class="banner">

  <div class="banner__graphics" aria-hidden="true">
    <img
      src="{{ 'Frame.svg' | asset_url }}"
      alt=""
      class="banner__frame banner__frame--top"
      loading="eager"
      width="1390"
      height="390"
    >

    <img
      src="{{ 'Frame2.svg' | asset_url }}"
      alt=""
      class="banner__frame banner__frame--bottom"
      loading="eager"
      width="890"
      height="402"
    >
  </div>

  <div class="page-width">

    <div class="banner__content">

      <p class="banner__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h1 class="banner__title">
        {{ section.settings.heading }}
      </h1>

      <div class="banner__description rte">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.button_link }}"
        class="banner__button"
      >
        <span>{{ section.settings.button_text }}</span>

        <svg
          class="banner__button-icon"
          width="18"
          height="12"
          viewBox="0 0 18 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M1 6H16M16 6L11 1M16 6L11 11"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Banner",
  "tag": "section",
  "class": "section-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p><p>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}