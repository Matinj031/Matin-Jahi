{{ 'tisso-wild.css' | asset_url | stylesheet_tag }}

<section class="tisso-wild">
  <div class="tisso-wild__inner">
    <h2 class="tisso-wild__heading">{{ section.settings.heading }}</h2>

    <div class="tisso-wild__grid" role="list">
      <div class="tisso-wild__item" role="listitem" style="--icon-x: 256.5px; --icon-y: 238px; --icon-left: 59.24%; --icon-top: 53.60%;">
        <img src="{{ 'gift-grid-1.png' | asset_url }}" alt="" class="tisso-wild__image" width="433" height="444" loading="lazy">
        <img src="{{ 'icon-plus.svg' | asset_url }}" alt="" class="tisso-wild__icon" width="22" height="22" loading="lazy">
      </div>

      <div class="tisso-wild__item" role="listitem" style="--icon-x: 355.5px; --icon-y: 222px; --icon-left: 82.10%; --icon-top: 50%;">
        <img src="{{ 'gift-grid-2.png' | asset_url }}" alt="" class="tisso-wild__image" width="433" height="444" loading="lazy">
        <img src="{{ 'icon-plus.svg' | asset_url }}" alt="" class="tisso-wild__icon" width="22" height="22" loading="lazy">
      </div>

      <div class="tisso-wild__item" role="listitem" style="--icon-x: 261px; --icon-y: 82px; --icon-left: 60.28%; --icon-top: 18.47%;">
        <img src="{{ 'gift-grid-3.png' | asset_url }}" alt="" class="tisso-wild__image" width="433" height="444" loading="lazy">
        <img src="{{ 'icon-plus.svg' | asset_url }}" alt="" class="tisso-wild__icon" width="22" height="22" loading="lazy">
      </div>

      <div class="tisso-wild__item" role="listitem" style="--icon-x: 301.5px; --icon-y: 71px; --icon-left: 69.63%; --icon-top: 15.99%;">
        <img src="{{ 'gift-grid-4.png' | asset_url }}" alt="" class="tisso-wild__image" width="433" height="444" loading="lazy">
        <img src="{{ 'icon-plus.svg' | asset_url }}" alt="" class="tisso-wild__icon" width="22" height="22" loading="lazy">
      </div>

      <div class="tisso-wild__item" role="listitem" style="--icon-x: 212.5px; --icon-y: 104px; --icon-left: 49.08%; --icon-top: 23.42%;">
        <img src="{{ 'gift-grid-5.png' | asset_url }}" alt="" class="tisso-wild__image" width="433" height="444" loading="lazy">
        <img src="{{ 'icon-plus.svg' | asset_url }}" alt="" class="tisso-wild__icon" width="22" height="22" loading="lazy">
      </div>

      <div class="tisso-wild__item" role="listitem" style="--icon-x: 319.5px; --icon-y: 164px; --icon-left: 73.79%; --icon-top: 36.94%;">
        <img src="{{ 'gift-grid-6.png' | asset_url }}" alt="" class="tisso-wild__image" width="433" height="444" loading="lazy">
        <img src="{{ 'icon-plus.svg' | asset_url }}" alt="" class="tisso-wild__icon" width="22" height="22" loading="lazy">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tisso Wild",
  "tag": "section",
  "class": "section-tisso-wild",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "presets": [
    {
      "name": "Tisso Wild"
    }
  ]
}
{% endschema %}
